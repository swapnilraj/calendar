<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="8dp" android:background="#FFF9F4"
    android:contentDescription="@string/widget_agenda_name">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_heading" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="@string/widget_agenda_name"
            android:textSize="16sp" android:textColor="#292722" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_today" android:layout_width="wrap_content" android:layout_height="40dp"
            android:gravity="center" android:paddingHorizontal="8dp" android:text="@string/widget_today"
            android:textColor="#35614B" android:textSize="13sp" android:visibility="gone" />
        <TextView android:id="@+id/widget_create" android:layout_width="wrap_content" android:layout_height="40dp"
            android:gravity="center" android:paddingHorizontal="8dp" android:text="@string/widget_create"
            android:textColor="#35614B" android:textSize="13sp" android:visibility="gone" />
    </LinearLayout>
    <TextView android:id="@+id/widget_message" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingVertical="8dp" android:text="@string/widget_setup" android:textColor="#56534D" android:textSize="14sp" />
    <LinearLayout android:id="@+id/widget_rows" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" />
    <TextView android:id="@+id/widget_coverage" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/widget_partial" android:textColor="#56534D" android:textSize="12sp" android:visibility="gone" />
    <LinearLayout android:orientation="vertical" android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/widget_setup" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="40dp" android:gravity="center_vertical" android:text="@string/widget_settings"
            android:textColor="#35614B" android:textSize="13sp" />
        <TextView android:id="@+id/widget_more" android:layout_width="wrap_content" android:layout_height="40dp"
            android:paddingHorizontal="8dp" android:gravity="center" android:text="@string/widget_more"
            android:textColor="#35614B" android:textSize="13sp" android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
