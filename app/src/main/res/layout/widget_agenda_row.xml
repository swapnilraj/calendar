<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_row" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="48dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingVertical="4dp">
    <TextView android:id="@+id/widget_color" android:layout_width="3dp" android:layout_height="32dp"
        android:importantForAccessibility="no" android:background="#7D857F" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="8dp" android:paddingEnd="4dp">
        <TextView android:id="@+id/widget_row_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="14sp" android:textColor="#292722" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_row_time" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="#56534D" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
